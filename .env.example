# ==============================================================================
# NephroScan AI - Environment Variables Reference for Local & Vercel Deployments
# ==============================================================================

# Flask Session Security Key (Required in Production)
SECRET_KEY=nephroscan-medical-ai-secure-random-key-replace-in-production

# Database Connection URL (Optional - defaults to /tmp/kidney_ai.db SQLite if omitted)
# For persistent multi-user clinical records on Vercel, connect a PostgreSQL database
# (e.g. Supabase, Neon, AWS RDS, Vercel Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/nephroscan_db

# Vercel Runtime Flags (Automatically injected by Vercel)
# VERCEL=1
